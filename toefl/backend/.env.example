# Bu dosyayı '.env' olarak KOPYALA ve değerleri doldur. (.env git'e girmez)
# AI açıklama için ücretsiz Groq anahtarı: https://console.groq.com → API Keys

AI_API_KEY=gsk_buraya_kendi_anahtarini_yaz
AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1   # varsayılan; değiştirmene gerek yok

# Yönetici e-postaları (opsiyonel; ilk kayıt olan zaten otomatik admin olur)
# TOEFL_ADMIN_EMAILS=senin@gmail.com

# Kalıcı veritabanı dizini (opsiyonel; Render disk kullanırsan)
# TOEFL_DB_DIR=/var/data
